generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  fullName              String?
  password              String?
  email                 String?            @unique
  phoneNumber           String?            @unique
  googleId              String?            @unique
  isPhoneNumberVerified Boolean            @default(false)
  homeAddress           String?
  longitude             Float?
  latitude              Float?
  isEmailVerified       Boolean            @default(false)
  isNotification        Boolean            @default(false)
  isBlocked             Boolean            @default(false)
  onlineStatus          OnlineStatus
  role                  UserRole
  modeOfRegistration    ModeOfRegistration
  userTimezone          String?
  country               String?
  city                  String?
  refreshToken          String?
  accessToken           String?
  profileImage          String?
  isUserVerified        Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  otp                   OTP?
  Driver                Driver?
  ridesAsUser           Ride[]             @relation(name: "UserRides")
  ridesAsDriver         Ride[]             @relation(name: "DriverRides")
  rideBids              RideBid[]
  rideCancellations     RideCancel[]
}

model Ride {
  id               String       @id @default(uuid())
  userId           String
  driverId         String?
  status           RideStatus   @default(pending)
  bids             RideBid[]
  cancellations    RideCancel[]
  pickupLocation   String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffLocation  String
  dropoffLatitude  Float
  dropoffLongitude Float
  userTimezone     String
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())

  user   User  @relation(name: "UserRides", fields: [userId], references: [id], onDelete: Cascade)
  driver User? @relation(name: "DriverRides", fields: [driverId], references: [id])
}

model RideBid {
  id        String    @id @default(uuid())
  rideId    String
  driverId  String
  amount    Float
  status    BidStatus @default(pending)
  createdAt DateTime  @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model RideCancel {
  id        String   @id @default(uuid())
  userId    String
  rideId    String
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum OnlineStatus {
  online
  offline
}

enum UserRole {
  rider
  driver
  admin
}

enum ModeOfRegistration {
  phoneNumber
  email
  googleId
}

model Driver {
  id                  String             @id @default(uuid())
  userId              String             @unique
  firstName           String
  middleName          String?
  lastName            String
  nationality         String
  dateOfBirth         DateTime
  fullAddress         String
  city                String
  postalCode          String
  country             String
  totalCompletedRides Int                @default(0)
  registrationStatus  RegistrationStatus
  registrationDate    DateTime           @default(now())
  approvalDate        DateTime?
  approvedBy          String?

  user            User                   @relation(fields: [userId], references: [id])
  identifications DriverIdentification[]
  vehicles        DriverVehicle[]
}

enum RegistrationStatus {
  pending
  incomplete
  approved
  rejected
  suspended
}

model DriverIdentification {
  id                   String           @id @default(uuid())
  driverId             String           @unique
  issuingCountry       String
  documentType         verificationType
  nin                  String?
  passportPhotoUrl     String?
  idCardFrontUrl       String?
  idCardBackUrl        String?
  licenseNumber        String
  licenseExpiryDate    String
  licensePhotoUrl      String
  selfieWithLicenseUrl String
  driver               Driver           @relation(fields: [driverId], references: [id])
}

enum verificationType {
  NIN
  Passport
  IdCard
}

model DriverVehicle {
  id                  String  @id @default(uuid())
  driverId            String  @unique
  carBrand            String
  carModel            String
  licensePlateNumber  String  @unique
  carColor            String
  carPictureUrl       String?
  vehicleRegistration String
  roadWorthiness      String?

  driver Driver @relation(fields: [driverId], references: [id])
}

enum RideStatus {
  pending
  accepted
  ongoing
  completed
  canceled
}

enum BidStatus {
  pending
  accepted
  rejected
}
