generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  fullName              String?
  password              String?
  email                 String?            @unique
  phoneNumber           String?            @unique
  googleId              String?            @unique
  isPhoneNumberVerified Boolean            @default(false)
  homeAddress           String?
  longitude             Float?
  latitude              Float?
  isEmailVerified       Boolean            @default(false)
  isNotification        Boolean            @default(false)
  onlineStatus          OnlineStatus
  role                  UserRole
  modeOfRegistration    ModeOfRegistration
  country               String?
  city                  String?
  resetToken            String?
  profileImage          String?
  isUserVerified        Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  otp OTP?
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  expiresAt DateTime
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum OnlineStatus {
  online
  offline
}

enum UserRole {
  rider
  driver
  admin
}

enum ModeOfRegistration {
  phoneNumber
  email
  googleId
}
