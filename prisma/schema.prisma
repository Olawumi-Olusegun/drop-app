generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  fullName              String?
  password              String?
  email                 String?            @unique
  phoneNumber           String?            @unique
  googleId              String?            @unique
  isPhoneNumberVerified Boolean            @default(false)
  homeAddress           String?
  longitude             Float?
  latitude              Float?
  isEmailVerified       Boolean            @default(false)
  isNotification        Boolean            @default(false)
  isBlocked             Boolean            @default(false)
  onlineStatus          OnlineStatus
  role                  UserRole
  modeOfRegistration    ModeOfRegistration
  userTimezone          String?
  country               String?
  city                  String?
  refreshToken          String?
  accessToken           String?
  profileImage          String?
  isUserVerified        Boolean            @default(false)
  averageRating         Float              @default(0.0)
  totalCompletedRides   Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  outstandingBalance    Float              @default(0.0)
  savedCardAuthCode     String?
  ActivityLog           ActivityLog[]      @relation("UserActivities")
  Driver                Driver?
  otp                   OTP?
  Payment               Payment[]
  ridesAsUser           Ride[]             @relation("UserRides")
  rideCancellations     RideCancel[]
  scheduledRidesAsUser  ScheduledRide[]    @relation("UserScheduledRides")
  userRatings           UserRating[]       @relation("UserRatings")
  Wallet                Wallet?
}

model Ride {
  id               String        @id @default(uuid())
  userId           String
  driverId         String?
  status           RideStatus    @default(pending)
  pickupLocation   String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffLocation  String
  dropoffLatitude  Float
  dropoffLongitude Float
  finalFare        Float?        @default(0.0)
  userTimezone     String
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  ActivityLog      ActivityLog[]
  Payment          Payment?
  driver           Driver?       @relation("DriverRides", fields: [driverId], references: [id])
  user             User          @relation("UserRides", fields: [userId], references: [id], onDelete: Cascade)
  bids             RideBid[]
  cancellations    RideCancel[]
}

model ScheduledRide {
  id                String     @id @default(uuid())
  riderId           String
  driverId          String?
  scheduledDateTime DateTime
  pickupLocation    String
  pickupLatitude    Float
  pickupLongitude   Float
  dropoffLocation   String
  dropoffLatitude   Float
  dropoffLongitude  Float
  finalFare         Float?     @default(0.0)
  userTimezone      String
  status            RideStatus @default(pending)
  createdAt         DateTime   @default(now())
  bids              RideBid[]
  driver            Driver?    @relation("DriverScheduledRides", fields: [driverId], references: [id])
  user              User       @relation("UserScheduledRides", fields: [riderId], references: [id])
}

model RideBid {
  id            String         @id @default(uuid())
  rideId        String?
  driverId      String
  amount        Float
  status        BidStatus      @default(pending)
  createdAt     DateTime       @default(now())
  biddingType   BiddingType    @default(instant)
  scheduledId   String?
  driver        Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  ride          Ride?          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  scheduledRide ScheduledRide? @relation(fields: [scheduledId], references: [id], onDelete: Cascade)
}

model RideCancel {
  id        String   @id @default(uuid())
  userId    String
  rideId    String
  reason    String
  createdAt DateTime @default(now())
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  expiresAt DateTime
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Driver {
  id                  String                @id @default(uuid())
  userId              String                @unique
  firstName           String
  middleName          String?
  lastName            String
  nationality         String
  dateOfBirth         DateTime
  fullAddress         String
  city                String
  postalCode          String
  country             String
  totalCompletedRides Int                   @default(0)
  averageRating       Float                 @default(0.0)
  registrationStatus  RegistrationStatus
  registrationDate    DateTime              @default(now())
  approvalDate        DateTime?
  approvedBy          String?
  activities          ActivityLog[]         @relation("DriverActivities")
  user                User                  @relation(fields: [userId], references: [id])
  identifications     DriverIdentification?
  vehicles            DriverVehicle?
  DriverWallet        DriverWallet?
  ridesAsDriver       Ride[]                @relation("DriverRides")
  rideBids            RideBid[]
  scheduledRides      ScheduledRide[]       @relation("DriverScheduledRides")
}

model DriverIdentification {
  id                   String           @id @default(uuid())
  driverId             String           @unique
  issuingCountry       String
  documentType         verificationType
  nin                  String?
  passportPhotoUrl     String?
  idCardFrontUrl       String?
  idCardBackUrl        String?
  licenseNumber        String
  licenseExpiryDate    String
  licensePhotoUrl      String
  selfieWithLicenseUrl String
  driver               Driver           @relation(fields: [driverId], references: [id])
}

model DriverVehicle {
  id                  String  @id @default(uuid())
  driverId            String  @unique
  carBrand            String
  carModel            String
  licensePlateNumber  String
  carColor            String
  carPictureUrl       String?
  vehicleRegistration String
  roadWorthiness      String?
  driver              Driver  @relation(fields: [driverId], references: [id])
}

model DriverWallet {
  id        String   @id @default(uuid())
  driverId  String   @unique
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id])
}

model UserRating {
  id        String   @id @default(uuid())
  userId    String
  driverId  String
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id             String       @id @default(uuid())
  userId         String
  driverId       String?
  rideId         String?
  activityType   ActivityType
  description    String
  subDescription String?
  createdAt      DateTime     @default(now())
  driver         Driver?      @relation("DriverActivities", fields: [driverId], references: [id], onDelete: Cascade)
  ride           Ride?        @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user           User         @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id
  rideId        String        @unique
  userId        String
  amount        Float
  netAmount     Float
  paymentMethod PaymentMethod
  status        PaymentStatus @default(pending)
  reference     String        @unique
  createdAt     DateTime      @default(now())
  Ride          Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  User          User          @relation(fields: [userId], references: [id])
}

model Wallet {
  id                String              @id
  userId            String              @unique
  balance           Float               @default(0.0)
  currency          String              @default("NGN")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  User              User                @relation(fields: [userId], references: [id])
  WalletTransaction WalletTransaction[]
}

model WalletTransaction {
  id        String            @id
  walletId  String
  type      TransactionType
  amount    Float
  reference String            @unique
  status    TransactionStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime
  Wallet    Wallet            @relation(fields: [walletId], references: [id])
}

enum verificationType {
  NIN
  Passport
  IdCard
}

enum ActivityType {
  ride_pending
  ride_ongoing
  ride_requested
  ride_accepted
  ride_started
  ride_completed
  ride_canceled
  bid_placed
  bid_accepted
  bid_rejected
  scheduled_ride_created
  scheduled_ride_completed
  scheduled_ride_canceled
  payment_processed
  rating_given
  rating_received
  profile_updated
  vehicle_updated
  wallet_credited
  wallet_debited
}

enum RideStatus {
  pending
  accepted
  ongoing
  completed
  canceled
}

enum BidStatus {
  pending
  accepted
  cancelled
  rejected
}

enum UserRole {
  rider
  driver
  admin
}

enum ModeOfRegistration {
  phoneNumber
  email
  googleId
}

enum RegistrationStatus {
  pending
  incomplete
  approved
  rejected
  suspended
}

enum BiddingType {
  instant
  scheduled
}

enum OnlineStatus {
  online
  offline
}

enum PaymentMethod {
  cash
  card
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum TransactionType {
  credit
  debit
}
