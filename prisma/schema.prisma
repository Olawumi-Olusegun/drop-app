generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  fullName              String?
  password              String?
  email                 String?            @unique
  phoneNumber           String?            @unique
  googleId              String?            @unique
  isPhoneNumberVerified Boolean            @default(false)
  homeAddress           String?
  longitude             Float?
  latitude              Float?
  isEmailVerified       Boolean            @default(false)
  isNotification        Boolean            @default(false)
  isBlocked             Boolean            @default(false)
  onlineStatus          OnlineStatus
  role                  UserRole
  modeOfRegistration    ModeOfRegistration
  userTimezone          String?
  country               String?
  city                  String?
  refreshToken          String?
  accessToken           String?
  profileImage          String?
  isUserVerified        Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  otp                   OTP?
  ridesAsDriver         Ride[]             @relation("DriverRides")
  ridesAsUser           Ride[]             @relation("UserRides")
  rideBids              RideBid[]
  rideCancellations     RideCancel[]
}

model Ride {
  id               String       @id @default(uuid())
  userId           String
  driverId         String?
  status           RideStatus   @default(pending)
  pickupLocation   String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffLocation  String
  dropoffLatitude  Float
  dropoffLongitude Float
  userTimezone     String
  expiresAt        DateTime?
  createdAt        DateTime     @default(now())
  driver           User?        @relation("DriverRides", fields: [driverId], references: [id])
  user             User         @relation("UserRides", fields: [userId], references: [id], onDelete: Cascade)
  bids             RideBid[]
  cancellations    RideCancel[]
}

model RideBid {
  id        String    @id @default(uuid())
  rideId    String
  driverId  String
  amount    Float
  status    BidStatus @default(pending)
  createdAt DateTime  @default(now())
  driver    User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
}

model RideCancel {
  id        String   @id @default(uuid())
  userId    String
  rideId    String
  reason    String
  createdAt DateTime @default(now())
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  expiresAt DateTime
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OnlineStatus {
  online
  offline
}

enum UserRole {
  rider
  driver
  admin
}

enum ModeOfRegistration {
  phoneNumber
  email
  googleId
}

enum RideStatus {
  pending
  accepted
  ongoing
  completed
  canceled
}

enum BidStatus {
  pending
  accepted
  rejected
}
